# Supabase — copy this file to .env and fill in your project values.
# Found in Supabase Dashboard → Project Settings → API.
# Only the anon/public key belongs here (it is safe for the browser).
# Never put the service_role key in a VITE_ variable — it would ship to clients.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
